# Set to the exact public HTTPS origin after provisioning your host.
# APP_ORIGIN=https://your-carenect-host.example
# Render's default onrender.com URL is detected automatically via RENDER_EXTERNAL_URL.
# Production must use a persistent volume at this path.
DATA_DIR=./data
# Local development uses SQLite. Render Free requires durable cloud storage:
# DATA_BACKEND=supabase
# SUPABASE_URL=https://your-project.supabase.co
# Configure SUPABASE_SECRET_KEY securely on the server. Do not paste it into chat.
